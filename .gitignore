!wallpapers/archive
!wallpapers/archive/**

# mwww music widget
!mwww/
!mwww/**
mwww/commands.fifo
mwww/songs/**

# themes
!themes/
!themes/**

# fastfetch
!fastfetch/
!fastfetch/**

# hyprland ecosystem
!hypr/
!hypr/**

# kitty terminal
!kitty/
!kitty/**

# starship
!starship.toml

# waybar status bar
!waybar/
!waybar/**

# wofi app launcher
!wofi/
!wofi/**

# theme picker
!theme-picker/
!theme-picker/**

# zen browser
!zen-browser/
!zen-browser/**

# git setup
!git/
!git/**

# cava (audio visualizer)
!cava/
!cava/**

# tmux (terminal multiplexer)
!tmux/
!tmux/**

# linux-desktop-gremlin
!/linux-desktop-gremlin/
!/linux-desktop-gremlin/manual_install.txt
!/linux-desktop-gremlin/manual_uninstall.txt
!/linux-desktop-gremlin/gremlin_picker.desktop

# readme
!README.md
